#!/usr/bin/env python3

import json
import os
import re
from datetime import date
from pathlib import Path

import requests
from bs4 import BeautifulSoup


USERNAME = os.environ.get("GITHUB_USERNAME", "naichal18").strip()

URL = f"https://github.com/users/{USERNAME}/contributions"

ROOT = Path(__file__).resolve().parents[1]
OUTPUT_FILE = ROOT / "data" / "contributions.json"


def extract_count(text):
    """
    Extract contribution count from text such as:

    '12 contributions on August 25th'
    '1 contribution on August 31st'
    'No contributions on August 30th'
    """

    if not text:
        return 0

    text = " ".join(text.split())

    match = re.search(
        r"(\d[\d,]*)\s+contributions?",
        text,
        re.IGNORECASE,
    )

    if match:
        return int(match.group(1).replace(",", ""))

    if re.search(
        r"\bno\s+contributions?\b",
        text,
        re.IGNORECASE,
    ):
        return 0

    return 0


def fetch_page():
    headers = {
        "User-Agent": (
            "Mozilla/5.0 "
            "(Windows NT 10.0; Win64; x64) "
            "AppleWebKit/537.36 "
            "(KHTML, like Gecko) "
            "Chrome/151.0.0.0 Safari/537.36"
        ),
        "Accept": (
            "text/html,"
            "application/xhtml+xml,"
            "application/xml;q=0.9,"
            "*/*;q=0.8"
        ),
        "Accept-Language": "en-US,en;q=0.9",
        "Referer": f"https://github.com/{USERNAME}",
        "X-Requested-With": "XMLHttpRequest",
    }

    response = requests.get(
        URL,
        headers=headers,
        timeout=30,
    )

    response.raise_for_status()

    return response.text


def parse_contributions(page_html):
    soup = BeautifulSoup(page_html, "html.parser")

    # Current GitHub contribution calendar:
    #
    # <td
    #     id="contribution-day-component-..."
    #     data-date="2026-08-25"
    #     data-level="4"
    # >
    #
    # The matching tooltip is a separate element:
    #
    # <tool-tip for="contribution-day-component-...">
    #     19 contributions on August 25th
    # </tool-tip>

    day_cells = soup.select(
        ".js-calendar-graph-table "
        ".ContributionCalendar-day[data-date]"
    )

    # Fallback if GitHub changes the class structure slightly.
    if not day_cells:
        day_cells = soup.select(
            "td[data-date][data-level]"
        )

    if not day_cells:
        raise RuntimeError(
            "Could not find GitHub contribution day cells."
        )

    # Build a map:
    #
    # contribution-cell-id -> tooltip
    #
    # This is the important fix.
    tooltip_map = {}

    tooltip_elements = soup.select(
        ".js-calendar-graph tool-tip"
    )

    if not tooltip_elements:
        tooltip_elements = soup.select(
            "tool-tip"
        )

    for tooltip in tooltip_elements:
        target_id = (
            tooltip.get("for")
            or tooltip.get("id")
            or tooltip.get("data-for")
        )

        if not target_id:
            continue

        tooltip_map[target_id] = tooltip

    days = []

    for cell in day_cells:
        contribution_date = cell.get("data-date")

        if not contribution_date:
            continue

        cell_id = cell.get("id")

        try:
            level = int(
                cell.get(
                    "data-level",
                    "0",
                )
            )
        except ValueError:
            level = 0

        level = max(
            0,
            min(
                5,
                level,
            ),
        )

        count = 0

        # ---------------------------------------------------------
        # PRIMARY METHOD
        # ---------------------------------------------------------
        #
        # Match the cell's id to <tool-tip for="...">
        #
        if cell_id and cell_id in tooltip_map:
            tooltip = tooltip_map[cell_id]

            tooltip_text = tooltip.get_text(
                " ",
                strip=True,
            )

            count = extract_count(
                tooltip_text
            )

        # ---------------------------------------------------------
        # FALLBACK METHOD
        # ---------------------------------------------------------
        #
        # Some GitHub markup variants can put the tooltip closer
        # to the contribution cell. Try descendants as well.
        #
        if count == 0:
            for tooltip in cell.find_all(
                "tool-tip"
            ):
                tooltip_text = tooltip.get_text(
                    " ",
                    strip=True,
                )

                count = extract_count(
                    tooltip_text
                )

                if count > 0:
                    break

        # ---------------------------------------------------------
        # SECOND FALLBACK
        # ---------------------------------------------------------
        #
        # Search nearby aria-label/text.
        #
        if count == 0:
            candidates = []

            aria_label = cell.get(
                "aria-label"
            )

            if aria_label:
                candidates.append(
                    aria_label
                )

            cell_text = cell.get_text(
                " ",
                strip=True,
            )

            if cell_text:
                candidates.append(
                    cell_text
                )

            for text in candidates:
                count = extract_count(
                    text
                )

                if count > 0:
                    break

        days.append(
            {
                "date": contribution_date,
                "count": count,
                "level": level,
            }
        )

    # Remove duplicate dates while preserving
    # the latest parsed value.
    unique_days = {}

    for item in days:
        unique_days[item["date"]] = item

    days = sorted(
        unique_days.values(),
        key=lambda item: item["date"],
    )

    return days


def main():
    print(
        f"Fetching GitHub contributions for {USERNAME}..."
    )

    html = fetch_page()

    days = parse_contributions(
        html
    )

    if not days:
        raise RuntimeError(
            "No contribution days were parsed."
        )

    total = sum(
        item["count"]
        for item in days
    )

    active_days = sum(
        1
        for item in days
        if item["count"] > 0
    )

    # GitHub normally provides approximately
    # 53 weeks of contribution data.
    days = days[-371:]

    total = sum(
        item["count"]
        for item in days
    )

    output = {
        "username": USERNAME,
        "updated": date.today().isoformat(),
        "total": total,
        "days": days,
    }

    OUTPUT_FILE.parent.mkdir(
        parents=True,
        exist_ok=True,
    )

    OUTPUT_FILE.write_text(
        json.dumps(
            output,
            indent=2,
            ensure_ascii=False,
        ),
        encoding="utf-8",
    )

    print("")
    print("=" * 60)
    print("GitHub contribution fetch completed")
    print("=" * 60)
    print(f"Username      : {USERNAME}")
    print(f"Days parsed    : {len(days)}")
    print(f"Active days    : {active_days}")
    print(f"Total          : {total}")
    print(f"Output         : {OUTPUT_FILE}")
    print("=" * 60)

    if total == 0:
        raise RuntimeError(
            "The parser returned TOTAL = 0. "
            "GitHub has contribution data, so refusing to "
            "overwrite the JSON with incorrect zero counts."
        )


if __name__ == "__main__":
    main()
